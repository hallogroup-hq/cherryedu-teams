# Cherry Edu Teams — Environment Variables
#
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# ─── Supabase (shared Cherry Edu identity ecosystem) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://yswtpmwfzqqeguiwogvj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── Database (staging: cherryedu_staging_db) ────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/cherryedu_staging_db

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TEAMS_URL=http://localhost:3001
NEXT_PUBLIC_B2C_URL=https://edu.cherrycoffeeroastery.com

